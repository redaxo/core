# Defines the environment variables of the project, loaded on every request (via symfony/dotenv).
# Real environment variables take precedence over this file.
# Machine-specific overrides belong in the gitignored `.env.local`.

# Unique id of this installation, used to namespace sessions and cookies.
# `composer create-project` generates a unique value automatically.
REX_INSTANCE_ID=redaxo

# The mode this instance runs in:
#   dev       Local development: verbose error output, warnings/notices thrown as exceptions.
#   live      Publicly reachable instances (production and staging): no error details for visitors, but
#             logged-in admins still get detailed error pages.
#   hardened  Like live, but additionally hardens the backend against compromised admin accounts (no error
#             details even for admins, no addon management, no backup import, no safe mode).
# Live servers must set the mode to `live` or `hardened`, via real env vars or the `.env.local` file.
REX_MODE=dev

# Force the backend into safe mode (addons are not loaded, can not be deactivated in the backend).
REX_SAFE_MODE=0
