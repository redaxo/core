{
    "name": "redaxo/core",
    "type": "library",
    "description": "REDAXO CMS core package",
    "keywords": ["redaxo", "cms", "content-management-system"],
    "license": "MIT",
    "homepage": "https://redaxo.org",
    "authors": [
        {
            "name": "Yakamara Media GmbH & Co. KG",
            "homepage": "https://yakamara.de"
        },
        {
            "name": "REDAXO team & community",
            "homepage": "https://redaxo.org"
        }
    ],

    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-fileinfo": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "composer-runtime-api": "^2",
        "composer/ca-bundle": "^1.5.14",
        "enshrined/svg-sanitize": "^1.0.0",
        "erusev/parsedown": "^1.8.0",
        "erusev/parsedown-extra": "^0.9.0",
        "filp/whoops": "^2.18.4",
        "intervention/image": "^4.3.2",
        "lbuchs/webauthn": "^2.2.0",
        "nyholm/psr7": "^1.8.2",
        "phpmailer/phpmailer": "^7.1.1",
        "psr/log": "^3.0.2",
        "ramsey/http-range": "^2.0.0",
        "splitbrain/php-archive": "^1.5.1",
        "symfony/console": "^8.1.6",
        "symfony/dotenv": "^8.1.6",
        "symfony/http-client": "^8.1.6",
        "symfony/http-foundation": "^8.1.6",
        "symfony/runtime": "^8.1.0",
        "symfony/var-dumper": "^8.1.6",
        "symfony/yaml": "^8.1.6",
        "voku/anti-xss": "^4.1.44"
    },
    "require-dev": {
        "jetbrains/phpstorm-attributes": "^1.3",
        "phpstan/extension-installer": "1.4.3",
        "phpstan/phpstan": "2.2.13",
        "phpstan/phpstan-deprecation-rules": "2.0.5",
        "phpstan/phpstan-phpunit": "2.0.18",
        "phpstan/phpstan-symfony": "2.0.20",
        "phpunit/phpunit": "^12.5.17 || ^13.1.14",
        "psalm/plugin-phpunit": "0.19.7",
        "psalm/plugin-symfony": "v5.3.0",
        "rector/rector": "2.6.6",
        "redaxo/debug": "^2.0@dev",
        "redaxo/php-cs-fixer-config": "3.1.3",
        "redaxo/project": "^6.0@dev",
        "redaxo/psalm-plugin": "2.2.1",
        "redaxo/test": "^1.0@dev",
        "shipmonk/phpstan-baseline-per-identifier": "2.3.0",
        "vimeo/psalm": "6.16.1"
    },

    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-intl-grapheme": "*",
        "symfony/polyfill-intl-normalizer": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*",
        "symfony/polyfill-php85": "*"
    },

    "conflict": {
        "composer/installers": "*"
    },

    "autoload": {
        "psr-4": {
            "Redaxo\\Core\\": "src"
        },
        "files": [
            "src/View/escape.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Redaxo\\Core\\Fixtures\\": ".tools/fixtures",
            "Redaxo\\Core\\Tests\\": "tests",
            "Redaxo\\Rector\\": ".tools/rector"
        }
    },

    "scripts": {
        "rebase-to-bugfix": "bash .tools/bin/rebase-to-bugfix",
        "refresh": "bash .tools/bin/refresh",
        "update:all": "bash .tools/bin/update-all",
        "update:tools": "bash .tools/bin/update-tools",
        "cs-fixer": "php-cs-fixer fix -v --ansi",
        "cs-fixer:no-cache": [
            "rm -f .php-cs-fixer.cache",
            "php-cs-fixer fix -v --using-cache=no --ansi"
        ],
        "phpunit": "phpunit --colors=always",
        "phpstan": "phpstan analyse --ansi -v",
        "phpstan:baseline": [
            "phpstan --generate-baseline=.tools/phpstan/baseline/_loader.php -v",
            "split-phpstan-baseline .tools/phpstan/baseline/_loader.php --no-error-count",
            "@cs-fixer .tools/phpstan/baseline"
        ],
        "phpstan:no-cache": [
            "phpstan clear-result-cache --ansi",
            "@phpstan"
        ],
        "psalm": "psalm --use-baseline=.tools/psalm/baseline.xml",
        "psalm:baseline": "psalm --set-baseline=.tools/psalm/baseline.xml --no-cache || true",
        "psalm:no-cache": [
            "psalm --clear-cache",
            "psalm --use-baseline=.tools/psalm/baseline.xml --no-cache"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "rector process --ansi"
        ],
        "rector:no-cache": [
            "Composer\\Config::disableProcessTimeout",
            "rector process --clear-cache --ansi"
        ],
        "taint": "psalm --use-baseline=.tools/psalm/baseline-taint.xml --taint-analysis --no-cache --threads=1",
        "taint:baseline": [
            "psalm --set-baseline=.tools/psalm/baseline-taint.xml --taint-analysis --no-cache --threads=1 || true",
            "git checkout -- psalm.xml"
        ],
        "cs": [
            "@rector",
            "@cs-fixer"
        ],
        "sa": [
            "@phpstan",
            "@psalm"
        ],
        "baseline": [
            "@phpstan:baseline",
            "@psalm:baseline",
            "@taint:baseline"
        ],
        "check": [
            "@cs",
            "@sa",
            "@phpunit",
            "@taint"
        ],

        "post-install-cmd": "bash .tools/bin/init-project",
        "post-update-cmd": "bash .tools/bin/init-project"
    },
    "scripts-descriptions": {
        "rebase-to-bugfix": "Rebase current branch onto bugfix",
        "refresh": "Refresh local instance (refresh core assets, re-install core, clear cache, update dev tools)",
        "update:all": "Update all vendor libs (php and js) in core and dev tools",
        "update:tools": "Update dev tools",
        "cs-fixer": "Fix code style via php-cs-fixer",
        "cs-fixer:no-cache": "Fix code style via php-cs-fixer (without cache)",
        "phpunit": "Run phpunit",
        "phpstan": "Run static analysis via phpstan",
        "phpstan:baseline": "Regenerate the phpstan baseline",
        "phpstan:no-cache": "Run static analysis via phpstan (without cache)",
        "psalm": "Run static analysis via psalm",
        "psalm:baseline": "Regenerate the psalm static analysis baseline",
        "psalm:no-cache": "Run static analysis via psalm (without cache)",
        "rector": "Fix code style via rector",
        "rector:no-cache": "Fix code style via rector (without cache)",
        "taint": "Run taint analysis via psalm",
        "taint:baseline": "Regenerate the psalm taint  analysis baseline",
        "cs": "Run all code style fixers (rector and php-cs-fixer)",
        "sa": "Run all static analyses (psalm and phpstan)",
        "check": "Check all (code style, static analysis, unit tests)"
    },

    "config": {
        "platform": {
            "php": "8.5.4"
        },
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "symfony/runtime": true
        }
    },

    "extra": {
        "runtime": {
            "class": "Redaxo\\Core\\Runtime"
        }
    },

    "repositories": [
        {
            "type": "path",
            "url": "addons/debug",
            "options": {
                "versions": {"redaxo/debug": "2.x-dev"}
            }
        },
        {
            "type": "path",
            "url": "addons/test",
            "options": {
                "versions": {"redaxo/test": "1.x-dev"}
            }
        },
        {
            "type": "path",
            "url": "project",
            "options": {
                "versions": {"redaxo/project": "6.x-dev"}
            }
        }
    ]
}
