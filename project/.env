# Defines the environment variables of the project, loaded on every request (via symfony/dotenv).
# Real environment variables take precedence over this file.
# Machine-specific overrides belong in the gitignored `.env.local`.

# Unique id of this installation, used to namespace sessions and cookies.
# `composer create-project` generates a unique value automatically.
REX_INSTANCE_ID=redaxo

# Force the backend into safe mode (addons are not loaded, can not be deactivated in the backend).
REX_SAFE_MODE=0

# Enable the live mode (disables debug mode, safe mode and other development features).
REX_LIVE_MODE=0
