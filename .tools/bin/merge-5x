#!/usr/bin/env bash

# This script merges the 5.x branch into 6.x and auto resolves some conflicts

set -e

find_renames=15%

while [[ $# -gt 0 ]]; do
    case "$1" in
        --find-renames=*)
            find_renames="${1#*=}"
            ;;
        --find-renames)
            find_renames="$2"
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
    esac
    shift
done

git fetch origin
git checkout 6.x
git pull

git merge origin/5.x --no-commit -X "find-renames=$find_renames" || [[ $? -le 1 ]]

# Auto-resolve conflicts in visual test screenshots and phpstan/psalm baselines (keep 6.x version)
git diff --name-only --diff-filter=U | grep -E '\.tools/(visual-tests/screenshots/|phpstan/baseline/|psalm/baseline)' | while read -r file; do
    if git ls-files -u -- "$file" | grep -q '^[0-7]* [0-9a-f]* 2'; then
        # 6.x has its own version -> keep it
        git checkout --ours "$file"
        git add "$file"
    else
        # 6.x deleted the file (e.g. baseline entry removed) -> keep it deleted
        git rm -f --ignore-unmatch "$file"
    fi
done

for dir in core addons/backup addons/be_style addons/cronjob addons/media_manager addons/mediapool addons/metainfo addons/phpmailer addons/structure addons/users; do
    git rm -f --ignore-unmatch -r "redaxo/src/$dir/vendor/"
    git rm -f --ignore-unmatch "redaxo/src/$dir/CHANGELOG.md"
    git rm -f --ignore-unmatch "redaxo/src/$dir/composer.lock"
done

git rm -f --ignore-unmatch -r "redaxo/src/addons/install/"

echo ""
echo "Please resolve all remaining conflicts manually."
echo ""
read -r -p "All conflicts resolved? (y/n) " answer

if [[ "$answer" != "y" ]]; then
    echo "Aborted."
    exit 1
fi

git commit --no-edit -m "Merge branch '5.x' into 6.x"

npm install
npm run build
composer cs-fixer
composer sa

# git push --force origin HEAD:temp
