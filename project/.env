# Defines the environment variables of the project, loaded on every request (via symfony/dotenv).
# Real environment variables take precedence over this file.
# Machine-specific overrides belong in the gitignored `.env.local`.

# Unique id of this installation, used to namespace sessions and cookies.
# `composer create-project` generates a unique value automatically.
REX_INSTANCE_ID=redaxo

# The mode this instance runs in:
#   dev       Local development: verbose error output, warnings/notices thrown as exceptions.
#   live      Publicly reachable instances (production and staging): no error details for visitors, but
#             logged-in admins still get detailed error pages.
#   hardened  Like live, but additionally hardens the backend against compromised admin accounts (no error
#             details even for admins, no backup import).
# Live servers must set the mode to `live` or `hardened`, via real env vars or the `.env.local` file.
REX_MODE=dev

# Name of this installation, shown in the backend and used in mail subjects and backup file names.
REX_INSTANCE_NAME=REDAXO

# Color used to visually mark this installation in the backend (any valid CSS color). Quote a hex value,
# otherwise the `#` starts a comment: REX_INSTANCE_COLOR='#3bb594'
REX_INSTANCE_COLOR=

# Absolute url of the frontend, e.g. https://example.org/. It is derived from the request (i.e. from the `Host`
# header) if empty, but required on the console to build absolute urls there. Live servers should set it.
REX_BASE_URL=

# Connection to the database, as a url. `DATABASE_URL` is the widely established name for this — several
# hosting platforms set it on their own when a database is provisioned.
#
# Special characters in the login or password must be percent-encoded; `/`, `?` and `#` make the url
# unparsable otherwise. Further connections are numbered without gaps: DATABASE_URL_2, DATABASE_URL_3, ...
#
# Optional settings are query parameters: persistent, ssl_key, ssl_cert, ssl_ca (a path, or 1 for the system
# store) and ssl_verify_server_cert. Unknown parameters are ignored.
DATABASE_URL=

# Recipient of error reports: errors from the system log are mailed to this address, which activates the reports.
# Identical errors are reported again only after REX_ERROR_EMAIL_INTERVAL seconds (default: 3600).
REX_ERROR_EMAIL=

# Enables a page in the backend that runs `console migrate` and, as long as no user exists, creates the first
# admin — for instances that are deployed without shell access. Reachable at `/redaxo/?rex_migrate=<token>`,
# never in the hardened mode, and only for as long as the token is set: it is not invalidated after an
# installation, so remove it once the instance is up.
REX_MIGRATE_TOKEN=

# Editor integration: backend links to source files open in this editor.
# One of: atom, emacs, idea, macvim, phpstorm, sublime, textmate, vscode, xdebug
REX_EDITOR=

# Local base path of the project, replacing the base path this installation actually runs in when building the
# editor links. Only needed if the two differ, e.g. when the web server runs in a container.
REX_EDITOR_BASEPATH=
