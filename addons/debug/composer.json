{
    "name": "redaxo/debug",
    "type": "redaxo-addon",
    "description": "REDAXO debug addon",
    "keywords": ["redaxo", "redaxo-addon", "debug", "clockwork", "profiler", "dev"],
    "license": "MIT",
    "homepage": "https://github.com/redaxo/core",
    "authors": [
        {
            "name": "Yakamara Media GmbH & Co. KG",
            "homepage": "https://yakamara.de"
        },
        {
            "name": "REDAXO team & community",
            "homepage": "https://redaxo.org"
        }
    ],

    "require": {
        "php": "^8.5",
        "ext-zip": "*",
        "redaxo/core": "^6.0",
        "itsgoingd/clockwork": "^5.3.5"
    },

    "autoload": {
        "psr-4": {
            "Redaxo\\Debug\\": "src/"
        },
        "classmap": [
            "lib/"
        ]
    },

    "extra": {
        "redaxo": {
            "addon-class": "Redaxo\\Debug\\DebugAddon"
        }
    }
}
