#!/usr/bin/env bash

composer require --dev --ansi --fixed --with-all-dependencies \
    phpstan/extension-installer \
    phpstan/phpstan \
    phpstan/phpstan-deprecation-rules \
    phpstan/phpstan-phpunit \
    phpstan/phpstan-symfony \
    psalm/plugin-phpunit \
    psalm/plugin-symfony \
    rector/rector \
    redaxo/php-cs-fixer-config \
    redaxo/psalm-plugin \
    shipmonk/phpstan-baseline-per-identifier \
    vimeo/psalm

composer update --ansi

composer bump --ansi \
    jetbrains/phpstorm-attributes \
    phpunit/phpunit

composer outdated --ansi

printf "\nUpdate npm packages\n"

for package in esbuild mkdirp pixelmatch playwright pngjs sass; do
    npm pkg set "devDependencies.$package=$(npm view "$package" version)"
done

npm pkg get devDependencies
